# META_API_KEY: Required. Key for the Meta Model API (Muse Spark), https://dev.meta.ai
META_API_KEY=""

# META_API_URL: Meta Model API base URL (Responses API). The default is fine for most setups.
META_API_URL="https://api.meta.ai/v1"

# MUSE_MODEL: Optional. Default Muse Spark model when the UI selection is not a known one (default muse-spark-1.3).
# MUSE_REASONING: Optional. Reasoning effort per scan: minimal (default, fastest), low, medium or high.
# MUSE_MODEL="muse-spark-1.3"
# MUSE_REASONING="minimal"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
